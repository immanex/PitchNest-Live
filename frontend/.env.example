# ── Frontend Environment Variables ──
# Set these in Vercel project settings.

# Backend origin. On any non-local host, browser requests to /api are sent here
# (see src/main.tsx). Defaults to https://pitchnestv1.onrender.com.
VITE_API_URL=https://your-backend-service.onrender.com

# WebSocket URL for the live pitch room.
# Format: wss://<your-render-service-name>.onrender.com/ws
VITE_WS_BACKEND_URL=wss://your-backend-service.onrender.com/ws

# Google OAuth Client ID (Optional, from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
