# ── Frontend Environment Variables ──

# WebSocket backend URL (Required when frontend is on Vercel and backend is on Render)
# Format: wss://<your-render-service-name>.onrender.com
VITE_WS_BACKEND_URL=wss://your-backend-service.onrender.com

# Google OAuth Client ID (Optional, from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
